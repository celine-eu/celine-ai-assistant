# Development or deployment. Only CELINE_ENV=dev relaxes anything; unset, prod,
# staging or a typo is hardened, and startup then refuses OAUTH2_TRUST_HEADERS=true,
# a missing OAUTH2_ISSUER or QDRANT_API_KEY, and a development database password.
# `task run` exports CELINE_ENV=dev. APP_ENV is still accepted as a fallback name,
# after CELINE_ENV and ENVIRONMENT.
# APP_ENV=dev
LOG_LEVEL=INFO

# The OpenAI-compatible endpoint every model call goes to (vLLM, Ollama, llama.cpp…).
# Required, with no default. For a local Ollama: http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
# Empty: the chat model.
LLM_VISION_MODEL=
# Empty: the chat endpoint and key.
LLM_EMBED_BASE_URL=
LLM_EMBED_MODEL=
# Empty: asked of the model once at startup.
LLM_EMBED_DIMENSIONS=
# Most a single model call may generate, reasoning included. Never off.
LLM_MAX_TOKENS=4096
# Empty: not sent, so the server uses the model's own recommended sampling.
LLM_TEMPERATURE=

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                # required outside dev
QDRANT_COLLECTION=celine_docs

KB_SOURCES_DIR=/app/data/kb-sources
KB_SYNC_ON_START=false
KB_GIT_TOKEN=
REC_ORGANIZATION_TYPE=rec

# Chat history storage (sqlite)
CHAT_DB_PATH=/data/chat_history.sqlite3

# User identity via oauth2-proxy headers; JWT verification.
# A presented token is verified against a CONFIGURED trust anchor: set OAUTH2_JWKS_URL
# (or OAUTH2_ISSUER, from which the JWKS is discovered). With neither set the token is
# refused rather than verified against the issuer it names for itself.
# Off by default. Turn on only behind a proxy on an isolated network that can set the
# x-auth-request-* headers itself; otherwise a request with no verifiable token is 401.
# Accepted with CELINE_ENV=dev only; refused at startup anywhere else.
OAUTH2_TRUST_HEADERS=false
OAUTH2_JWKS_URL=
OAUTH2_ISSUER=                 # required outside dev (with the JWKS URL alone `iss` is unchecked)
OAUTH2_AUDIENCE=
# Accepted signature algorithms, comma/JSON list. Pinned; not read from the token header.
OAUTH2_ALGORITHMS=["RS256"]
OAUTH2_JWT_COOKIE_NAME=

# Uploads
UPLOADS_URI=file:///app/data/uploads
MAX_UPLOAD_MB=25
